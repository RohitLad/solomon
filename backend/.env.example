# Copy to backend/.env (or project root .env) and fill in.
PORT=8080
DB_PATH=./solomon.db
UPLOAD_DIR=./uploads

# Frontend dev server proxies to this; no change needed locally.
OAUTH_REDIRECT_BASE=http://localhost:8080/api/accounts/callback

# --- Real API credentials (leave empty for demo/mock mode) ---
# X API v2 (https://developer.x.com) — OAuth 2.0 PKCE, scopes: tweet.read tweet.write offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Facebook / Instagram Graph v21 (https://developers.facebook.com) — FB Login
FB_APP_ID=
FB_APP_SECRET=
# Google / YouTube Data v3 (https://console.cloud.google.com) — scope youtube.upload
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok Content Posting v2 (https://developers.tiktok.com) — Login Kit + video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# LinkedIn (https://developer.linkedin.com) — w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Pinterest v5 (https://developers.pinterest.com) — boards/pins read+write
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Prod media must be PUBLICLY reachable for IG/FB/TikTok/YT uploads.
# Point this at your CDN or ngrok URL, e.g. https://abc123.ngrok.io/uploads/
PUBLIC_MEDIA_BASE_URL=http://localhost:8080/uploads/

# --- AI captions (optional — offline templates are used when empty) ---
# Any OpenAI-compatible chat-completions endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
